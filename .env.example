# Copy this file to .env and adjust if needed.
# Resource identifiers and non-secret settings only -- NEVER put API keys,
# AWS access keys, or any other secret in this file. Secrets go in
# .env.local instead (see .env.local.example) -- gitignored, and never
# written to by this app; you manage that file yourself.
#
# Load order (highest priority first): real environment variables,
# then .env.local, then .env.

AWS_REGION=ap-south-1
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=anthropic.claude-haiku-5-5

# Filled in automatically by scripts/setup_aws.py (resource IDs, not secrets)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
DYNAMODB_TABLE_NAME=WasteMgmt

APP_HOST=127.0.0.1
APP_PORT=8000

# Auto-generated on first run if left blank -- signs the local browser
# session cookie only, never sent to AWS or Google.
SESSION_SECRET=

# --- Chatbot provider ---
# auto (default): try Gemini, then Bedrock (if configured), then the
# offline assistant. Or pin to one provider: gemini | bedrock | offline.
CHATBOT_PROVIDER=auto
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=8
BEDROCK_TIMEOUT_SECONDS=5
